module "use client";
import { parseAsString, useQueryState } from "@octanejs/nuqs";
import { createContext, useContext } from "octane";
import type { OctaneNode } from "octane";
module
  // Tab values
  type ProviderTab = "overview" |  "meld" | "moonpay";
  // Panel content variables
  type ProviderPanelState = {
    ~ meldEndpointId?: string;
    ~ meldApiKey?: string;
    ~ meldEnvironment?: string;
    ~ };
  const ProviderContext = createContext<{
    tab: ProviderTab;
    setTab: (tab: ProviderTab) => void;
    meldEndpointId: string | null;
    setMeldEndpointId: (id: string | null) => void;
  } | null>(null);
  export function useProviderContext() {
    return useContext(ProviderContext);
  }

props { children }: { children: OctaneNode }
setup
  const [tab, setTabQuery] = useQueryState("tab", parseAsString.withDefault("overview").withOptions({
    history: "push",
    shallow: false
  }));

  const [meldEndpointId, setMeldEndpointId] = useQueryState("meld.endpoint", parseAsString.withOptions({
    history: "push",
    shallow: false
  }));

  const [paygateTab, setPaygateTab] = useQueryState("moonpay.tab", parseAsString.withOptions({
    history: "push",
    shallow: false
  }));

  const setTab = (value: ProviderTab) => {
    setTabQuery(value);
  };
ProviderContext(
  ~ value={{
  ~ tab: tab as ProviderTab,
  ~ setTab,
  ~ meldEndpointId,
  ~ setMeldEndpointId,
  ~ }}
  ~ )
  | #{children}
