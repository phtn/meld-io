module "use client";
import { useEffect, useState } from "octane";
import { useRouter, useRouterState } from "@octanejs/tanstack-router";
import { Group, Panel, Separator, usePanelRef, type PanelSize } from "@octanejs/resizable-panels";
import Shell from "./components/Shell.btsx";
import MeldContent from "./components/MeldContent.btsx";
import Sidebar from "./components/Sidebar.btsx";
import MobileSidebar from "./components/MobileSidebar.btsx";
import EndpointSelector from "./components/EndpointSelector.btsx";
import { ThemeToggle } from "./components/ThemeProvider.btsx";
import { getEndpointById } from "./lib/meld/endpoints";
import Topbar from "./components/Topbar.btsx";
import { createEmptyWalletAddressSettings, parseWalletAddressSettings } from "./lib/meld/request-presets";
import type { WalletAddressSettings } from "./lib/meld/request-presets";

setup
  const defaultEndpointId = "crypto-post-payments-crypto-quote";
  const router = useRouter();
  const search = useRouterState({ select: (state) => state.location.search });
  const requestedEndpointId = typeof search.endpoint === "string" ? search.endpoint : defaultEndpointId;
  const selectedEndpoint = getEndpointById(requestedEndpointId) ?? getEndpointById(defaultEndpointId);
  const selectedEndpointId = selectedEndpoint?.id ?? defaultEndpointId;
  const [defaultSetIndex, setDefaultSetIndex] = useState(0);
  const [walletAddresses, setWalletAddresses] = useState<WalletAddressSettings>(createEmptyWalletAddressSettings());
  const [walletSettingsReady, setWalletSettingsReady] = useState(false);
  const [mobileNavOpen, setMobileNavOpen] = useState(false);
  const [isCompact, setIsCompact] = useState(false);
  const sidebarPanelRef = usePanelRef();
  useEffect(() => {
    try {
      setWalletAddresses(parseWalletAddressSettings(window.localStorage.getItem("meld-wallet-addresses")));
    } catch {
      setWalletAddresses(createEmptyWalletAddressSettings());
    }
    setWalletSettingsReady(true);
  }, []);
  useEffect(() => {
    if (!walletSettingsReady) return;
    try {
      window.localStorage.setItem("meld-wallet-addresses", JSON.stringify(walletAddresses));
    } catch {
      // Settings remain active for this session if browser storage is unavailable.
    }
  }, [walletAddresses, walletSettingsReady]);
  const handleEndpointChange = (endpointId: string) => {
    void router.navigate({
      to: "/api",
      search: (current) => ({ ...current, endpoint: endpointId }),
      replace: true,
      resetScroll: false,
    });
    setMobileNavOpen(false);
  };
  const handleSidebarResize = (size: PanelSize) => setIsCompact(size.inPixels <= 80);
  const toggleSidebar = () => {
    const panel = sidebarPanelRef.current;
    if (!panel) return;
    if (panel.isCollapsed()) panel.expand();
    else panel.collapse();
  };

Shell
  Group(id="meld-workspace-layout" className="min-h-0 w-full bg-background text-foreground" style={{ height: "100dvh" }})
    Panel(
      ~ id="endpoint-sidebar-panel"
      ~ panelRef={sidebarPanelRef}
      ~ defaultSize="19rem"
      ~ minSize="15rem"
      ~ maxSize="30rem"
      ~ collapsedSize="4rem"
      ~ collapsible={true}
      ~ onResize={handleSidebarResize}
      ~ className="h-full min-h-0 min-w-0 overflow-hidden"
      ~ style={{ overflow: "hidden" }}
      ~ )
      Sidebar(path="/api" isCompact={isCompact} toggleSidebar={toggleSidebar})
        EndpointSelector(selectedEndpoint={selectedEndpointId} onSelect={handleEndpointChange})
    Separator(
      ~ id="sidebar-resize-separator"
      ~ aria-label="Resize endpoint sidebar"
      ~ className="group relative z-20 flex w-0 shrink-0 cursor-col-resize touch-none items-center justify-center bg-transparent outline-none before:absolute before:inset-y-0 before:left-1/2 before:w-px before:-translate-x-1/2 before:bg-sidebar-border before:transition-colors hover:before:bg-foreground/40 focus-visible:before:bg-focus data-[separator=active]:before:bg-foreground"
      ~ )
    Panel(
      ~ id="workspace-content-panel"
      ~ minSize="0px"
      ~ className="h-full min-h-0 min-w-0 overflow-hidden"
      ~ style={{ overflow: "hidden" }}
      ~ )
      div(className="flex h-full min-h-0 min-w-0 flex-1 flex-col overflow-hidden bg-background text-foreground")
        div(className="md:hidden")
          MobileSidebar(open={mobileNavOpen} onOpenChange={(open: boolean) => setMobileNavOpen(open)} title="Meld API Studio" endpointPath={selectedEndpoint?.path} defaultSetIndex={defaultSetIndex} onDefaultSetChange={setDefaultSetIndex} walletAddresses={walletAddresses} onWalletAddressesChange={setWalletAddresses})
            EndpointSelector(selectedEndpoint={selectedEndpointId} onSelect={handleEndpointChange})
        div(className="hidden md:block")
          Topbar(endpointPath={selectedEndpoint?.path} defaultSetIndex={defaultSetIndex} onDefaultSetChange={setDefaultSetIndex} walletAddresses={walletAddresses} onWalletAddressesChange={setWalletAddresses})
        main(className="min-h-0 min-w-0 flex-1 overflow-hidden")
          div(className="mx-auto h-full min-h-0 w-full max-w-[1800px]")
            section(className="hidden _flex flex-col justify-between gap-5 md:flex-row md:items-end")
              div(className="max-w-2xl")
                p(className="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground") Developer workspace
                h1(className="text-3xl font-semibold tracking-tight sm:text-4xl") Explore the Meld API
                p(className="mt-3 max-w-xl text-sm leading-6 text-muted-foreground") Browse all Meld API categories, build a request, and inspect its response in one place.
              div(className="flex items-center gap-3")
                span(className="inline-flex w-fit items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-800 dark:border-emerald-900/70 dark:bg-emerald-950/50 dark:text-emerald-300")
                  span(className="size-1.5 rounded-full bg-emerald-500")
                  | Workspace ready
                div(className="md:hidden")
                  ThemeToggle
            MeldContent(selectedEndpointId={selectedEndpointId} defaultSetIndex={defaultSetIndex} walletAddresses={walletAddresses})
