import { cn } from "@/lib/utils";

module
  type MethodProps = {
    method: string
    selected?: boolean
  }
  const METHOD_STYLES = {
    GET: {
      letter: "G",
      selected: "bg-[#82D8F0] dark:bg-[#58CEEE]",
      unselected: "bg-[#82D8F0] dark:bg-[#58CEEE]/75",
    },
    POST: {
      letter: "P",
      selected: "bg-[#FDCA7B] dark:bg-[#FDC268]",
      unselected: "bg-[#FDCA7B] dark:bg-[#FDC268]/75",
    },
    PUT: {
      letter: "P",
      selected: "bg-[#FDCA7B] dark:bg-[#FDC268]",
      unselected: "bg-[#FDCA7B] dark:bg-[#FDC268]/75",
    },
    PATCH: {
      letter: "P",
      selected: "bg-[#EAB0FD] dark:bg-[#E397FC]",
      unselected: "bg-[#EAB0FD] dark:bg-[#E397FC]/75",
    },
    DELETE: {
      letter: "D",
      selected: "bg-[#FC9785] dark:bg-[#FB806A]",
      unselected: "bg-[#FC9785] dark:bg-[#FB806A]/75",
    },
  } as const
props { method, selected }: MethodProps
setup
  const methodStyle = METHOD_STYLES[method as keyof typeof METHOD_STYLES];
  const methodColor = (methodStyle ?? METHOD_STYLES.DELETE)[selected ? "selected" : "unselected"];
  const letter = methodStyle?.letter ?? "P";
span(
  ~ className={cn("grid size-5 shrink-0 place-items-center rounded-[5px] font-mono text-[13px] font-bold leading-none text-[#111111] dark:text-white shadow-sm", methodColor)}
  ~ )
  | #{letter}
