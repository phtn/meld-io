import { cn } from "@/lib/utils";

props { method }: { method: string }
setup
  const methodColor = method === "GET"
    ? "bg-[#82D8F0] dark:bg-[#58CEEE]"
    : method === "POST" || method === "PUT"
      ? "bg-[#FDCA7B] dark:bg-[#FDC268]"
      : method === "PATCH"
        ? "bg-[#EAB0FD] dark:bg-[#E397FC]"
        : "bg-[#FC9785] dark:bg-[#FB806A]";
  const letter = method === "GET" ? "G" : method === "DELETE" ? "D" : "P";
span(
  ~ className={cn("grid size-5 shrink-0 place-items-center rounded-[5px] font-mono text-[14px] font-bold leading-none text-[#111111] dark:text-white", methodColor)}
  ~ )
  | #{letter}
