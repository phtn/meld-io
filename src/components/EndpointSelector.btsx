module "use client";
import Method from "./Method.btsx";
import { Icon } from "@/lib/icons";
import { endpointCategories, meldEndpoints } from "@/lib/meld/endpoints";
import { cn } from "@/lib/utils";
import { useLayoutEffect, useRef, useState } from "octane";

module
  interface CategoryListProps {
    categories: Array<{
      id: string;
      name: string;
      endpoints: typeof meldEndpoints;
    }>;
    selectedEndpoint: string;
    onSelect: (endpointId: string) => void;
    collapsedCategories: Record<string, boolean>;
    onToggleCategory: (categoryId: string) => void;
  }

  interface EndpointSelectorProps {
    ~ selectedEndpoint: string;
    ~ onSelect: (endpointId: string) => void;
  }

component CategoryList
  props { categories, selectedEndpoint, onSelect, collapsedCategories, onToggleCategory }: CategoryListProps
  each category in categories key category.id
    section
      button(
        ~ type="button"
        ~ aria-expanded={!collapsedCategories[category.id]}
        ~ aria-controls={`endpoint-category-${category.id}`}
        ~ onClick={() => onToggleCategory(category.id)}
        ~ className="sticky top-0 z-15 mb-2 flex w-full items-center justify-between gap-2 rounded-md bg-surface p-2 text-left transition-colors hover:bg-sidebar-border/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus"
        ~ )
        span(className="truncate text-[10px] font-normal uppercase tracking-widest text-muted-foreground") #{category.name}
        span(className="flex shrink-0 items-center gap-2 font-mono text-2xs tabular-nums text-muted-foreground")
          | #{category.endpoints.length}
          Icon(name="chevron-down" size={8} className={cn("transition-transform duration-150", collapsedCategories[category.id] && "-rotate-90")})
      div(id={`endpoint-category-${category.id}`} hidden={collapsedCategories[category.id]} className="space-y-1")
        each endpoint in category.endpoints key endpoint.id
          button(
            ~ onClick={() => onSelect(endpoint.id)}
            ~ data-selected-endpoint={selectedEndpoint === endpoint.id ? "true" : undefined}
            ~ disabled={endpoint.categoryDeprecated || endpoint.deprecated}
            ~ className={cn(
            ~ "relative z-10 flex w-full min-w-0 items-center gap-3.5 rounded-[10px] border-0 border-transparent px-2 py-2 text-left text-sm transition-colors focus-visible:ring-2 focus-visible:ring-focus",
            ~ selectedEndpoint === endpoint.id
            ~ ? "bg-[#111111] text-[#F8F8F8] dark:bg-[#F7F7F7] dark:text-[#111111]"
            ~ : "bg-transparent text-foreground/70 hover:text-foreground",
            ~ "disabled:cursor-not-allowed disabled:opacity-45",
            ~ )}
            ~ )
            div(className="flex min-w-0 flex-1 items-center gap-3")
              Method(method={endpoint.method} selected={selectedEndpoint === endpoint.id})
              span(className="min-w-0 flex-1 truncate font-mono text-xs font-medium leading-tight sm:text-[13px] tracking-tighter") #{endpoint.name}
              if endpoint.deprecated || endpoint.categoryDeprecated
                span(className="shrink-0 text-[9px] font-semibold uppercase tracking-wide text-amber-300 dark:text-amber-800") Deprecated

props { selectedEndpoint, onSelect }: EndpointSelectorProps
setup
  const [searchQuery, setSearchQuery] = useState("");
  const [collapsedCategories, setCollapsedCategories] = useState<Record<string, boolean>>({});
  const endpointListRef = useRef<HTMLDivElement | null>(null);
  const toggleCategory = (categoryId: string) => {
    setCollapsedCategories((current) => ({ ...current, [categoryId]: !current[categoryId] }));
  };
  const query = searchQuery.trim().toLowerCase();
  const filteredCategories = endpointCategories.map((category) => ({
    ...category,
    endpoints: meldEndpoints.filter((endpoint) =>
        endpoint.categoryId === category.id && (!query ||
        endpoint.name.toLowerCase().includes(query) ||
        endpoint.path.toLowerCase().includes(query) ||
        endpoint.description.toLowerCase().includes(query) ||
        category.name.toLowerCase().includes(query) ||
        (category.deprecated && query.includes("deprecated"))),
    ),
  })).filter((category) => category.endpoints.length > 0);
  const activeCategories = filteredCategories.filter((category) => !category.deprecated);
  const deprecatedCategories = filteredCategories.filter((category) => category.deprecated);
  useLayoutEffect(() => {
    const selectedItem = endpointListRef.current?.querySelector<HTMLElement>("[data-selected-endpoint]");
    selectedItem?.scrollIntoView({ block: "nearest", inline: "nearest" });
  }, [selectedEndpoint]);

div(className="min-w-0 bg-transparent")
  .px-2.mb-2
    input(
      ~ aria-label="Search endpoints"
      ~ className="w-full rounded-[8px] mt-1 border-0 border-sidebar-border bg-background/60 px-2.5 py-2 text-sm text-foreground outline-none transition placeholder:text-muted-foreground/70 focus-visible:ring-2 focus-visible:ring-focus"
      ~ type="text"
      ~ placeholder="Search API"
      ~ value={searchQuery}
      ~ onInput={(event) => setSearchQuery(event.currentTarget.value)}
      ~ )
  div(ref={endpointListRef} className="max-h-[calc(100dvh-8rem)] space-y-4 overflow-y-auto px-2 pb-3")
    if activeCategories.length > 0
      section(className="space-y-1")
        h3(className="hidden px-2 pt-1 font-normal text-xs uppercase tracking-widest text-muted-foreground/70") Active endpoints
        CategoryList(categories={activeCategories} selectedEndpoint={selectedEndpoint} onSelect={onSelect} collapsedCategories={collapsedCategories} onToggleCategory={toggleCategory})
    if deprecatedCategories.length > 0
      section(className="space-y-2 border-t border-sidebar-border pt-3")
        div(className="px-2")
          h3(className="font-normal text-xs uppercase tracking-widest text-warning-foreground") Deprecated endpoints
          p(className="mt-1 text-[11px] leading-4 text-muted-foreground") Retained for reference; unavailable for new requests.
        CategoryList(categories={deprecatedCategories} selectedEndpoint={selectedEndpoint} onSelect={onSelect} collapsedCategories={collapsedCategories} onToggleCategory={toggleCategory})
    if filteredCategories.length === 0
      p(className="px-2 py-6 text-center text-xs text-muted-foreground") No endpoints match this search.
