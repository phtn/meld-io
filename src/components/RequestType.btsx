import Method from "@/components/Method.btsx";
import ParamType from "@/components/ParamType.btsx";
import Title from "@/components/Title.btsx";
import type { EndpointConfig } from "@/lib/meld/endpoints";
import {Icon} from "@/lib/icons";
import { useId, useState } from "octane";
module
  interface RequestTypeProps {
    ~ endpoint: EndpointConfig;
    ~ }

props { endpoint }: RequestTypeProps
setup
  const [detailsVisible, setDetailsVisible] = useState(false);
  const [paramsVisible, setParamsVisible] = useState(false);
  const detailsId = useId();
  const paramsId = useId();

div(className="space-y-4 bg-white p-4 dark:bg-zinc-800")
  div
    div(className="mb-1 flex flex-wrap items-center gap-2")
      p(className="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500 dark:text-zinc-400") #{endpoint.category}
      if endpoint.deprecated || endpoint.categoryDeprecated
        span(className="rounded-full bg-amber-100 px-2 py-0.5 text-[9px] font-semibold uppercase tracking-wide text-amber-800 dark:bg-amber-950 dark:text-amber-300") Deprecated
    div(className='flex items-center space-x-3')
      h2(className="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100") #{endpoint.name}
      button(
        ~ type="button"
        ~ aria-label={detailsVisible ? "Hide endpoint details" : "Show endpoint details"}
        ~ aria-expanded={detailsVisible}
        ~ aria-controls={detailsId}
        ~ onClick={() => setDetailsVisible(!detailsVisible)}
        ~ className="grid size-7 shrink-0 place-items-center rounded-full text-blue-500 transition-colors hover:bg-blue-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus dark:text-blue-400 dark:hover:bg-blue-950/50"
        ~ )
        Icon(name='info-circle' className='size-4')
      button(
        ~ type="button"
        ~ aria-label={paramsVisible ? "Hide endpoint parameters" : "Show endpoint parameters"}
        ~ aria-expanded={paramsVisible}
        ~ aria-controls={paramsId}
        ~ onClick={() => setParamsVisible(!paramsVisible)}
        ~ className="rounded-full px-2 py-1 font-mono text-xs uppercase text-indigo-400 transition-colors hover:bg-indigo-100/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus"
        ~ ) params

    if detailsVisible
      div(id={detailsId} className="mt-2 space-y-3")
        p(className="text-sm leading-5 text-zinc-600 dark:text-zinc-400") #{endpoint.description}
        div(className="flex flex-wrap items-center gap-2")
          Method(method={endpoint.method})
          code(className="break-all font-mono text-xs text-zinc-600 dark:text-zinc-400") #{endpoint.path}
    if endpoint.categoryNotice
      p(className="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900 dark:border-amber-900/70 dark:bg-amber-950/50 dark:text-amber-200") #{endpoint.categoryNotice}
  if paramsVisible
    div(id={paramsId} className="space-y-4")
      Title(text="Endpoint parameters")
      if endpoint.parameters.length > 0
        .space-y-3
          each param in endpoint.parameters key `${param.in}:${param.name}`
            div(className="border-b border-zinc-200 pb-3 last:border-0 dark:border-zinc-800")
              div(className="flex items-start justify-between gap-2")
                div(className="flex min-w-0 items-center gap-1 text-xs font-medium text-zinc-900 dark:text-zinc-100")
                  span(className="shrink-0 rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[9px] uppercase text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400") #{param.in}
                  span(className="break-all") #{param.name}
                  if param.required
                    div(className="size-1.5 shrink-0 aspect-square rounded-full bg-red-400")
                ParamType(type={param.schema.type || "string"})
              if param.description
                p(className="mt-1 whitespace-pre-line text-xs leading-5 text-zinc-500 dark:text-zinc-500") #{param.description}
      else
        p(className="text-xs text-zinc-500 dark:text-zinc-400") No endpoint parameters.
  if endpoint.requestBody
    details(className="rounded-xl border border-zinc-200 dark:border-zinc-800")
      summary(className="cursor-pointer px-3 py-2.5 text-xs font-semibold text-zinc-700 dark:text-zinc-300") Request body schema · #{endpoint.requestBody.contentType || "JSON"}
      div(className="border-t border-zinc-200 p-3 dark:border-zinc-800")
        if endpoint.requestBody.description
          p(className="mb-2 whitespace-pre-line text-xs leading-5 text-zinc-500") #{endpoint.requestBody.description}
        pre(className="max-h-80 overflow-auto rounded-lg bg-zinc-50 p-3 font-mono text-[10px] leading-4 text-zinc-700 dark:bg-zinc-950 dark:text-zinc-300") #{JSON.stringify(endpoint.requestBody.schema, null, 2)}
