import { Link, useRouter } from "@octanejs/tanstack-router";
import { useEffect, useState } from "octane";
import { Group, Panel, Separator, usePanelRef, type PanelSize } from "@octanejs/resizable-panels";
import { endDemoAccountSession } from "@/lib/account-session";
import { useMeldApi } from "@/hooks/use-meld-api";
import AccountVolumeChart from "@/components/AccountVolumeChart.btsx";
import { Icon } from "@/lib/icons";
import Sidebar, {ToggleSidebar} from "@/components/Sidebar.btsx";
import { ThemeToggle } from "@/components/ThemeProvider.btsx";
import { cn } from "@/lib/utils";
import type { ApiResponse } from "@/types";

module
  const EXAMPLE_CUSTOMER_ID = "WmYtQbDgrToZG684RC2bpJ";

  interface MeldCustomer {
    id: string;
    externalId?: string;
    name?: { firstName?: string; lastName?: string };
    email?: string;
    status?: string;
    type?: string;
  }

  function isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === "object" && value !== null && !Array.isArray(value);
  }

  function getExampleCustomer(data: unknown): MeldCustomer | null {
    if (!isRecord(data) || !Array.isArray(data.customers)) return null;
    const customer = data.customers.find((value) => isRecord(value) && value.id === EXAMPLE_CUSTOMER_ID);
    if (!isRecord(customer)) return null;

    const name = isRecord(customer.name) ? customer.name : undefined;
    return {
      id: typeof customer.id === "string" ? customer.id : EXAMPLE_CUSTOMER_ID,
      externalId: typeof customer.externalId === "string" ? customer.externalId : undefined,
      name: name ? {
        firstName: typeof name.firstName === "string" ? name.firstName : undefined,
        lastName: typeof name.lastName === "string" ? name.lastName : undefined,
      } : undefined,
      email: typeof customer.email === "string" ? customer.email : undefined,
      status: typeof customer.status === "string" ? customer.status : undefined,
      type: typeof customer.type === "string" ? customer.type : undefined,
    };
  }

  function getRequestError(response: ApiResponse | null): string | null {
    if (!response || response.success) return null;
    if (response.error) return response.error;
    if (isRecord(response.data)) {
      if (typeof response.data.error === "string") return response.data.error;
      if (typeof response.data.message === "string") return response.data.message;
    }
    return "Meld API request failed.";
  }

setup
  const router = useRouter();
  const [isSidebarCompact, setIsSidebarCompact] = useState(false);
  const [isUserMenuOpen, setIsUserMenuOpen] = useState(false);
  const { loading: customerLoading, response: customerResponse, handleApiCall } = useMeldApi();
  const sidebarPanelRef = usePanelRef();
  const customer = customerResponse?.success ? getExampleCustomer(customerResponse.data) : null;
  const customerError = getRequestError(customerResponse);
  const customerName = customer
    ? [customer.name?.firstName, customer.name?.lastName].filter(Boolean).join(" ") || customer.externalId || "Unnamed customer"
    : "";
  const customerInitials = customerName.split(" ").filter(Boolean).slice(0, 2).map((part) => part[0]).join("").toUpperCase() || "XP";
  const userMenuName = customer
    ? customerName
    : customerLoading || !customerResponse
      ? "Loading customer…"
      : customerError
        ? "Demo user"
        : "Customer not found";
  const userMenuSubtitle = customer?.email ?? (customerLoading ? "Loading sandbox customer" : "Sandbox customer");
  const handleSidebarResize = (size: PanelSize) => setIsSidebarCompact(size.inPixels <= 90);
  const toggleSidebar = () => {
    const panel = sidebarPanelRef.current;
    if (!panel) return;
    if (panel.isCollapsed()) panel.expand();
    else if (isSidebarCompact) panel.resize("238px");
    else panel.collapse();
  };
  const handleSignOut = () => {
    endDemoAccountSession();
    void router.navigate({ to: "/account/sign-in" });
  };

  useEffect(() => {
    handleApiCall(
      "/accounts/customers",
      "",
      "sandbox",
      "GET",
      undefined,
      { customerIds: EXAMPLE_CUSTOMER_ID },
      undefined,
      true,
    );
  }, []);

