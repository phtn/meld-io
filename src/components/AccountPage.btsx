import { Link, Outlet, useRouter, useRouterState } from "@octanejs/tanstack-router";
import { useEffect, useState } from "octane";
import { Group, Panel, Separator, usePanelRef, type PanelSize } from "@octanejs/resizable-panels";
import { DEMO_CUSTOMER_ID, endDemoAccountSession } from "@/lib/account-session";
import { useMeldApi } from "@/hooks/use-meld-api";
import { Icon } from "@/lib/icons";
import Sidebar, {ToggleSidebar} from "@/components/Sidebar.btsx";
import { ThemeToggle } from "@/components/ThemeProvider.btsx";
import { cn } from "@/lib/utils";
import type { ApiResponse } from "@/types";

module
  interface MeldCustomer {
    id: string;
    externalId?: string;
    name?: { firstName?: string; lastName?: string };
    email?: string;
    status?: string;
    type?: string;
  }

  function isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === "object" && value !== null && !Array.isArray(value);
  }

  function getExampleCustomer(data: unknown): MeldCustomer | null {
    if (!isRecord(data) || !Array.isArray(data.customers)) return null;
    const customer = data.customers.find((value) => isRecord(value) && value.id === DEMO_CUSTOMER_ID);
    if (!isRecord(customer)) return null;

    const name = isRecord(customer.name) ? customer.name : undefined;
    return {
      id: typeof customer.id === "string" ? customer.id : DEMO_CUSTOMER_ID,
      externalId: typeof customer.externalId === "string" ? customer.externalId : undefined,
      name: name ? {
        firstName: typeof name.firstName === "string" ? name.firstName : undefined,
        lastName: typeof name.lastName === "string" ? name.lastName : undefined,
      } : undefined,
      email: typeof customer.email === "string" ? customer.email : undefined,
      status: typeof customer.status === "string" ? customer.status : undefined,
      type: typeof customer.type === "string" ? customer.type : undefined,
    };
  }

  function getRequestError(response: ApiResponse | null): string | null {
    if (!response || response.success) return null;
    if (response.error) return response.error;
    if (isRecord(response.data)) {
      if (typeof response.data.error === "string") return response.data.error;
      if (typeof response.data.message === "string") return response.data.message;
    }
    return "Meld API request failed.";
  }

setup
  const router = useRouter();
  const pathname = useRouterState({ select: (state) => state.location.pathname });
  const isOverviewActive = pathname === "/account" || pathname === "/account/";
  const [isSidebarCompact, setIsSidebarCompact] = useState(false);
  const [isUserMenuOpen, setIsUserMenuOpen] = useState(false);
  const { loading: customerLoading, response: customerResponse, handleApiCall } = useMeldApi();
  const sidebarPanelRef = usePanelRef();
  const customer = customerResponse?.success ? getExampleCustomer(customerResponse.data) : null;
  const customerError = getRequestError(customerResponse);
  const customerName = customer
    ? [customer.name?.firstName, customer.name?.lastName].filter(Boolean).join(" ") || customer.externalId || "Unnamed customer"
    : "";
  const customerInitials = customerName.split(" ").filter(Boolean).slice(0, 2).map((part) => part[0]).join("").toUpperCase() || "XP";
  const userMenuName = customer
    ? customerName.split(' ').shift()
    : customerLoading || !customerResponse
      ? "Loading …"
      : customerError
        ? "Demo user"
        : "Customer not found";
  const userMenuSubtitle = customer?.email ?? (customerLoading ? "Loading sandbox customer" : "Sandbox customer");
  const handleSidebarResize = (size: PanelSize) => setIsSidebarCompact(size.inPixels <= 90);
  const toggleSidebar = () => {
    const panel = sidebarPanelRef.current;
    if (!panel) return;
    if (panel.isCollapsed()) panel.expand();
    else if (isSidebarCompact) panel.resize("238px");
    else panel.collapse();
  };
  const handleSignOut = () => {
    endDemoAccountSession();
    void router.navigate({ to: "/account/sign-in" });
  };

  useEffect(() => {
    handleApiCall(
      "/accounts/customers",
      "",
      "sandbox",
      "GET",
      undefined,
      { customerIds: DEMO_CUSTOMER_ID },
      undefined,
      true,
    );
  }, []);

main.account-dashboard-page
  div.account-dashboard-frame
    Group(id="account-dashboard-layout" className="account-dashboard-layout" style={{ height: "100dvh" }})
      Panel(
        ~ id="account-sidebar-panel"
        ~ panelRef={sidebarPanelRef}
        ~ defaultSize="238px"
        ~ minSize="180px"
        ~ maxSize="320px"
        ~ collapsedSize="76px"
        ~ collapsible={true}
        ~ onResize={handleSidebarResize}
        ~ className="account-sidebar-panel"
        ~ style={{ overflow: "hidden" }}
        ~ )
        Sidebar(
          ~ path="/account"
          ~ isCompact={isSidebarCompact}
          ~ toggleSidebar={toggleSidebar}
          ~ className="account-sidebar"
          ~ childrenClassName="account-sidebar-custom-navigation"
          ~ ariaLabel="Account navigation"
          ~ hideOnMobile={false}
          ~ hideHeader={true}
          ~ hideFooter={true}
          ~ childrenAlwaysVisible={true}
          ~ )
          div.account-sidebar-header(data-sidebar-hover-ignore="true")
            div.account-brand
              Link.account-brand-link(to='/')
                Icon(name='logo' className={cn('size-4', {'size-6': isSidebarCompact})})
                span(className={isSidebarCompact ? 'hidden!': ''}) cex
              ToggleSidebar(isCompact={isSidebarCompact} toggleSidebar={toggleSidebar} className={`justify-end ${isSidebarCompact && 'hidden'}`})
            div.account-workspace(className='hidden!')
              span.account-workspace-icon ◈
              div.account-workspace-copy
                strong Northstar Wallet
                span Sandbox workspace
              span.account-workspace-chevron ⌄
          nav.account-sidebar-navigation
            p.account-nav-label Workspace
            Link(
              ~ to="/account"
              ~ className={cn("account-sidebar-link", isOverviewActive && "account-sidebar-link--active")}
              ~ aria-current={isOverviewActive ? "page" : undefined}
              ~ )
              Icon.account-sidebar-icon(name='bar-chart' className='size-2')
              span Overview
            Link(
              ~ to="/account/transactions"
              ~ className={cn("account-sidebar-link", pathname === "/account/transactions" && "account-sidebar-link--active")}
              ~ aria-current={pathname === "/account/transactions" ? "page" : undefined}
              ~ )
              Icon.account-sidebar-icon(name='transaction' className='-rotate-90')
              span Transactions
              span.account-sidebar-count 8
            a.account-sidebar-link(href="#bank-accounts")
              Icon.account-sidebar-icon(name='bank')
              span Bank Accounts
            Link(
              ~ to="/account/logs"
              ~ className={cn("account-sidebar-link", pathname === "/account/logs" && "account-sidebar-link--active")}
              ~ aria-current={pathname === "/account/logs" ? "page" : undefined}
              ~ )
              Icon.account-sidebar-icon(name='list')
              span Logs
              span.account-sidebar-tag Live
            p.account-nav-label.account-nav-label--spaced In flight
            div.account-flight-item
              span.account-flight-dot.account-flight-dot--blue
              span Meridian Wallet
              small Day 12
            div.account-flight-item
              span.account-flight-dot.account-flight-dot--orange
              span Eastbank Pay
              small Day 28
            div.account-flight-item
              span.account-flight-dot.account-flight-dot--yellow
              span Northstar Wallet
              small Day 47
          nav.account-sidebar-compact-navigation(aria-label="Account navigation")
            Link(
              ~ to="/account"
              ~ className={cn("account-sidebar-link", "account-sidebar-compact-link", isOverviewActive && "account-sidebar-link--active")}
              ~ aria-current={isOverviewActive ? "page" : undefined}
              ~ aria-label="Overview"
              ~ title="Overview"
              ~ )
              span.account-sidebar-icon ▦
            Link(
              ~ to="/account/transactions"
              ~ className={cn("account-sidebar-link", "account-sidebar-compact-link", pathname === "/account/transactions" && "account-sidebar-link--active")}
              ~ aria-current={pathname === "/account/transactions" ? "page" : undefined}
              ~ aria-label="Transactions"
              ~ title="Transactions"
              ~ )
              span.account-sidebar-icon ▤
            Link(
              ~ to="/account/logs"
              ~ className={cn("account-sidebar-link", "account-sidebar-compact-link", pathname === "/account/logs" && "account-sidebar-link--active")}
              ~ aria-current={pathname === "/account/logs" ? "page" : undefined}
              ~ aria-label="Logs"
              ~ title="Logs"
              ~ )
              Icon.account-sidebar-icon(name='list')
            a.account-sidebar-link.account-sidebar-compact-link(href="#payment-routes" aria-label="Payment routes" title="Payment routes")
              span.account-sidebar-icon ⇄
            a.account-sidebar-link.account-sidebar-compact-link(href="#developers" aria-label="Developers" title="Developers")
              span.account-sidebar-icon ⌘
          div.account-sidebar-bottom
            div.account-sidebar-gate
              Icon.account-sidebar-gate-icon(name='flag')
              div
                strong Next milestone
                span Production review · 3 steps
            a.account-sidebar-link(href="#settings")
              Icon.account-sidebar-icon(name='settings')
              span Settings
            button.account-sidebar-link(type="button" onClick={handleSignOut})
              Icon.account-sidebar-icon(name='sign-out')
              span Sign out
            div.account-sidebar-theme-toggle
              ThemeToggle

      Separator(
        ~ id="account-sidebar-resize-separator"
        ~ aria-label="Resize account sidebar"
        ~ className="account-dashboard-resize-separator"
        ~ )
      Panel(
        ~ id="account-content-panel"
        ~ minSize="0px"
        ~ className="account-dashboard-content-panel"
        ~ style={{ overflow: "auto" }}
        ~ )
        section.account-dashboard-content
          header.account-dashboard-header
            div.account-heading
              div.account-heading-title
                h1 Northstar Wallet
                Icon.account-user-chevron(name='chevron-down' className='size-2.5')
            div.account-header-actions
              div.account-search(className='hidden!')
                span.account-search-icon ⌕
                span Search
                span.account-search-shortcut ⌘ K
              div.account-user-menu-wrap
                button.account-user-menu(
                  ~ type="button"
                  ~ aria-label={`Account menu for ${userMenuName}`}
                  ~ aria-haspopup="dialog"
                  ~ aria-expanded={isUserMenuOpen}
                  ~ aria-controls="account-customer-menu"
                  ~ onClick={() => setIsUserMenuOpen(!isUserMenuOpen)}
                  ~ )
                  span.account-user-avatar #{customerInitials}
                  div.account-user-copy
                    strong #{userMenuName}
                if isUserMenuOpen
                  div#account-customer-menu.account-user-menu-dropdown(role="dialog" aria-labelledby="account-customer-menu-title")
                    div.account-user-menu-dropdown-header
                      div
                        h2#account-customer-menu-title Account customer
                        p Sandbox API profile
                      button.account-user-menu-close(type="button" aria-label="Close account customer menu" onClick={() => setIsUserMenuOpen(false)})
                        Icon(name='close' className='size-3.5')
                    if customerLoading || !customerResponse
                      p.account-user-menu-state(role="status") Loading customer account…
                    if customerError
                      p.account-user-menu-state.account-user-menu-state--error(role="alert") #{customerError}
                    if customerResponse?.success && !customer
                      p.account-user-menu-state No customer was returned for #{DEMO_CUSTOMER_ID}.
                    if customer
                      dl.account-user-detail-list
                        div.account-user-detail
                          dt Customer ID
                          dd #{customer.id}
                        if customer.externalId
                          div.account-user-detail
                            dt External ID
                            dd #{customer.externalId}
                        div.account-user-detail
                          dt Status
                          dd #{customer.status ?? "Unknown"}
                        div.account-user-detail
                          dt Type
                          dd #{customer.type ?? "Unknown"}
                        div.account-user-detail
                          dt Email
                          dd #{customer.email ?? "Not provided"}
              button.account-notifications(type="button" aria-label="Notifications")
                Icon(name='bell' className='size-4')
                i
          Outlet
