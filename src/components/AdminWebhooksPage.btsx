import { useCallback, useEffect, useState } from "octane";
import { useMeldApi } from "@/hooks/use-meld-api";
import { formatAccountDate, getApiError, isRecord } from "@/lib/account-data";
import type { WebhookProfile } from "@/lib/meld/webhook-event-types";
import JsonViewer from "@/components/JsonViewer.btsx";
import Tabs, { type TabItem } from "@/ui/Tabs.btsx";
import Drawer, { DrawerClose } from "@/ui/Drawer.btsx";
import { Icon } from "@/lib/icons";

module
  interface WebhookEvent {
    id: string;
    receivedAt: string;
    eventType: string;
    eventId: string | null;
    accountId: string | null;
    profileId: string | null;
    version: string | null;
    timestamp: string | null;
    deliveries: number;
    body: unknown;
  }

  const ALL_PROFILES_TAB = "all";

  function isWebhookProfile(value: unknown): value is WebhookProfile {
    return isRecord(value) && typeof value.id === "string" && typeof value.name === "string";
  }

  function getWebhookProfiles(data: unknown): WebhookProfile[] {
    if (!isRecord(data) || !Array.isArray(data.webhookProfiles)) return [];
    return data.webhookProfiles.filter(isWebhookProfile);
  }

  function getStatusClass(status: string): string {
    return /fail|error|declin|cancel|inactive|disabled/i.test(status)
      ? "account-status account-status--failed"
      : "account-status";
  }

setup
  const [events, setEvents] = useState<WebhookEvent[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [expandedId, setExpandedId] = useState<string | null>(null);
  const [activeProfileId, setActiveProfileId] = useState(ALL_PROFILES_TAB);
  const [detailsOpen, setDetailsOpen] = useState(false);
  const [isMobile, setIsMobile] = useState(false);
  const { loading: profilesLoading, response: profilesResponse, handleApiCall } = useMeldApi();
  const profilesError = getApiError(profilesResponse);
  const profiles = profilesResponse?.success ? getWebhookProfiles(profilesResponse.data) : [];
  const activeProfile = profiles.find((profile) => profile.id === activeProfileId) ?? null;
  const profileTabs: TabItem[] = [
    { id: ALL_PROFILES_TAB, label: "All" },
    ...profiles.map((profile) => ({ id: profile.id, label: profile.name })),
  ];
  const visibleEvents = activeProfile ? events.filter((event) => event.profileId === activeProfile.id) : events;

  const loadEvents = useCallback(async () => {
    setLoading(true);
    try {
      const result = await fetch("/api/admin/webhooks", { headers: { Accept: "application/json" } });
      const data = await result.json();
      if (!result.ok) throw new Error(typeof data?.error === "string" ? data.error : "Unable to load webhooks.");
      setEvents(Array.isArray(data.events) ? data.events : []);
      setError(null);
    } catch (loadError) {
      setError(loadError instanceof Error ? loadError.message : "Unable to load webhooks.");
    } finally {
      setLoading(false);
    }
  }, []);

  const selectProfile = (profileId: string) => {
    setActiveProfileId(profileId);
    setExpandedId(null);
  };

  useEffect(() => {
    const media = window.matchMedia("(max-width: 767px)");
    const updateLayout = () => setIsMobile(media.matches);
    updateLayout();
    media.addEventListener("change", updateLayout);
    return () => media.removeEventListener("change", updateLayout);
  }, []);

  useEffect(() => {
    void loadEvents();
  }, [loadEvents]);

  useEffect(() => {
    void handleApiCall(
      "/notifications/webhooks",
      "",
      "sandbox",
      "GET",
      undefined,
      { limit: "100" },
      undefined,
      true,
    );
  }, [handleApiCall]);

fragment
  div.account-dashboard-tabs(className='overflow-x-auto')
    Tabs(
      ~ activeId={activeProfileId}
      ~ className="account-dashboard-tab-list"
      ~ items={profileTabs}
      ~ label="Webhook profiles"
      ~ onSelect={selectProfile}
      ~ )
    if profilesLoading || !profilesResponse
      span(className='shrink-0 text-xs text-muted-foreground' role="status") Loading profiles…
    elseif profilesError
      span(className='shrink-0 text-xs text-red-500' role="alert") #{profilesError}
    if activeProfile
      button.account-route-date-pill(
        ~ type="button"
        ~ className='ml-auto shrink-0'
        ~ aria-expanded={detailsOpen}
        ~ aria-controls="webhook-profile-details"
        ~ onClick={() => setDetailsOpen(true)}
        ~ ) View details

  if activeProfile
    Drawer(
      ~ open={detailsOpen}
      ~ onOpenChange={(open: boolean) => setDetailsOpen(open)}
      ~ side={isMobile ? "bottom" : "right"}
      ~ title={`${activeProfile.name} webhook profile`}
      ~ description="Webhook profile details"
      ~ swipeToOpen={false}
      ~ className={isMobile ? undefined : "w-[min(28rem,calc(100vw-3rem))] rounded-l-xl"}
      ~ contentClassName="bg-background"
      ~ backdropClassName="bg-black/20! backdrop-blur-none!"
      ~ )
      div#webhook-profile-details(className='flex flex-col gap-6 p-6')
        if isMobile
          div(className='mx-auto -mt-2 h-1 w-10 rounded-full bg-muted-foreground/30' aria-hidden='true')
        div(className='flex items-start justify-between gap-3')
          div(className='flex min-w-0 flex-col gap-2')
            h2(className='truncate font-sans text-lg font-medium tracking-tight') #{activeProfile.name}
            div(className='flex items-center gap-2')
              span(className={getStatusClass(activeProfile.status)}) #{activeProfile.status}
              span(className='font-mono text-xs text-muted-foreground') v#{activeProfile.eventVersion}
          DrawerClose(type='button' aria-label='Close profile details' className='grid size-9 shrink-0 place-items-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring')
            Icon(name='close' className='size-4')
        dl(className='flex flex-col gap-5 text-sm')
          div(className='flex flex-col gap-1.5')
            dt(className='text-xs uppercase tracking-widest text-muted-foreground') Profile Id
            dd(className='font-mono break-all') #{activeProfile.id}
          div(className='flex flex-col gap-1.5')
            dt(className='text-xs uppercase tracking-widest text-muted-foreground') URL
            dd(className='font-mono break-all') #{activeProfile.url}
          div(className='flex flex-col gap-1.5')
            dt(className='text-xs uppercase tracking-widest text-muted-foreground') Event types
            dd
              if activeProfile.eventTypes.length === 0
                span All events
              else
                div(className='flex flex-wrap gap-1.5')
                  each eventType in activeProfile.eventTypes key eventType
                    span.account-status #{eventType}

  div.account-dashboard-grid.account-route-record-grid
    section.account-panel.account-route-panel(aria-labelledby="webhooks-title")
      div.account-route-panel-header
        div(className='flex items-center gap-3')
          h2#webhooks-title Received webhooks
          span(className='size-6 rounded-full bg-sunken font-sans font-[450] text-sm flex items-center justify-center') #{visibleEvents.length}
        button.account-route-date-pill(type="button" onClick={() => void loadEvents()} disabled={loading})
          | #{loading ? "Refreshing…" : "Refresh"}
      if loading && events.length === 0
        p.account-route-state(role="status") Loading webhooks…
      elseif error
        p.account-route-state.account-route-state--error(role="alert") #{error}
      elseif visibleEvents.length === 0
        p.account-route-state #{activeProfile ? `No webhooks received for ${activeProfile.name} yet.` : "No webhooks received yet. Meld delivers to POST /api/webhooks/meld."}
      else
        div.account-route-table-scroll
          table.account-route-table
            thead
              tr
                th(scope="col") Event
                th(scope="col") Event Id
                th(scope="col") Account
                th(scope="col") Deliveries
                th(scope="col") Event time
                th(scope="col") Received
            tbody
              each event in visibleEvents key event.id
                fragment
                  tr(
                    ~ className="cursor-pointer hover:bg-foreground/5"
                    ~ aria-expanded={expandedId === event.id}
                    ~ onClick={() => setExpandedId(expandedId === event.id ? null : event.id)}
                    ~ )
                    td
                      span(className={getStatusClass(event.eventType)}) #{event.eventType}
                    td.account-route-id #{event.eventId ?? "—"}
                    td #{event.accountId ?? "—"}
                    td(className='font-mono') #{event.deliveries}
                    td(className='font-mono') #{event.timestamp ? formatAccountDate(event.timestamp) : "—"}
                    td(className='font-mono') #{formatAccountDate(event.receivedAt)}
                  if expandedId === event.id
                    tr
                      td(colSpan={6})
                        JsonViewer(data={event.body} defaultExpandDepth={2} withToolbar={true})
