import { cn } from "@/lib/utils"
import Button from "@/ui/Button.btsx";
import { Link } from "@octanejs/tanstack-router";
import { type ReactNode, useState } from "octane";
import { AnimatePresence, motion, useReducedMotion } from "@octanejs/motion"


module
  const MotionLi = motion.li
  interface TopbarProps {
      toggleSidebar?: VoidFunction
      toggleExtra?: VoidFunction
      isCompact?: boolean
      isMobile?: boolean
      endpointPath?: string
      children?: ReactNode
    }
  export interface BrandProps {
    brandName?: string
    imageUrl?: string
    imageAlt?: string
    className?: string
    children?: unknown
  }

component Divebar
  props {}:{}
  setup
    const [open, setOpen] = useState(false)
  button(className='h-[13px] w-[15px] rounded-[3.5px] bg-muted-foreground flex items-center p-0.5 relative' onClick={() => setOpen(!open)})
    div(className={cn('h-[10px] w-[5px] rounded-[2px] bg-background absolute transition-all duration-280 ease-out', {'translate-x-[6px]': open})})
component Brand
  props {brandName='Web app', imageUrl, imageAlt = "Web App", className, children }: BrandProps
  setup
    const BRAND_CLASS = "flex items-center gap-3"


  div(className={cn(BRAND_CLASS, className)})
    Link(className="flex items-center gap-4" to="/")
      h1(className='font-sans font-semibold text-xl tracking-tight') #{brandName}
    div #{children}


props { toggleExtra, isCompact = false, endpointPath, children }: TopbarProps
setup
  const reducedMotion = useReducedMotion() === true
header(className="sticky top-0 z-40 backdrop-blur-3xl w-full border-b border-sidebar-border dark:border-surface/33")
  div(className="topbar w-full px-6 flex items-center justify-between gap-4")
    nav(aria-label="Endpoint path" className="min-w-0 flex-1 overflow-x-auto")
      ol(className="flex w-max min-w-0 items-center gap-1 py-1 text-sm")
        AnimatePresence(mode="sync")
          each path in endpointPath ? [endpointPath] : [] key path
            MotionLi(
              ~ initial={false}
              ~ animate={{ opacity: 1, clipPath: 'inset(0 0% 0 0)' }}
              ~ exit={{ opacity: 0, clipPath: 'inset(0 100% 0 0)', transition: { duration: reducedMotion ? 0 : 0.35, ease: [0.67, 0.12, 0.29, 0.97] } }}
              ~ className="flex min-w-0 items-center gap-3"
              ~ )
              span(className="smooth-reveal breadcrumb-reveal")
                span
                  code(aria-current="page" title={path} className="inline-block max-w-[min(55vw,42rem)] truncate align-bottom font-mono text-xs font-medium text-foreground sm:text-sm") #{path}
    if toggleExtra || children
      div(className="flex shrink-0 items-center gap-2")
        if toggleExtra
          Button(onClick={toggleExtra} className='size-6') T
        | #{children}
