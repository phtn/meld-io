module "use client";
import { createRootRoute, createRoute, createRouter, Outlet, redirect, RouterProvider } from "@octanejs/tanstack-router";
import App from "./App.btsx";
import AccountPage from "./components/AccountPageTheme.btsx";
import AccountOverviewPage from "./components/AccountOverviewPage.btsx";
import LandingPage from "./components/LandingPage.btsx";
import SignInPage from "./components/SignInPage.btsx";
import TransactionResultPage from "./components/TransactionResultPage.btsx";
import AccountTransactionsPage from "./components/AccountTransactionsPage.btsx";
import AccountLogsPage from "./components/AccountLogsPage.btsx";
import { hasDemoAccountSession } from "./lib/account-session";

component RouteLayout
  Outlet

component SuccessPage
  TransactionResultPage(outcome="success")

component FailedPage
  TransactionResultPage(outcome="failed")

setup
  const rootRoute = createRootRoute({ component: RouteLayout });
  const landingRoute = createRoute({ getParentRoute: () => rootRoute, path: "/", component: LandingPage });
  const apiRoute = createRoute({ getParentRoute: () => rootRoute, path: "/api", component: App });
  const successRoute = createRoute({ getParentRoute: () => rootRoute, path: "/success", component: SuccessPage });
  const failedRoute = createRoute({ getParentRoute: () => rootRoute, path: "/failed", component: FailedPage });
  const accountSignInRoute = createRoute({ getParentRoute: () => rootRoute, path: "/account/sign-in", component: SignInPage });
  const accountRoute = createRoute({
    getParentRoute: () => rootRoute,
    path: "/account",
    beforeLoad: () => {
      if (!hasDemoAccountSession()) throw redirect({ to: "/account/sign-in" });
    },
    component: AccountPage,
  });
  const accountOverviewRoute = createRoute({
    getParentRoute: () => accountRoute,
    path: "/",
    component: AccountOverviewPage,
  });
  const accountTransactionsRoute = createRoute({
    getParentRoute: () => accountRoute,
    path: "transactions",
    component: AccountTransactionsPage,
  });
  const accountLogsRoute = createRoute({
    getParentRoute: () => accountRoute,
    path: "logs",
    component: AccountLogsPage,
  });
  const accountRouteTree = accountRoute.addChildren([
    accountOverviewRoute,
    accountTransactionsRoute,
    accountLogsRoute,
  ]);
  const routeTree = rootRoute.addChildren([
    landingRoute,
    apiRoute,
    successRoute,
    failedRoute,
    accountSignInRoute,
    accountRouteTree,
  ]);
  const router = createRouter({ routeTree });

RouterProvider(router={router})
